{
  "name": "DocIntel | AI Gateway",
  "nodes": [
    {
      "id": "d2f7dc85-3f4f-49a0-8b52-50ee0f46868b",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "docintel/ai",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "9e8806b6-900b-47a7-8143-54f7897c0dc4",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "<your httpHeaderAuth credential>"
        }
      }
    },
    {
      "id": "f0e8a972-00c7-4f6d-b2df-9e0975870d33",
      "name": "Check request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "\n// Allow-list: only these OpenAI endpoints can be reached through the gateway.\nconst ALLOWED = { responses: 'https://api.openai.com/v1/responses',\n                  embeddings: 'https://api.openai.com/v1/embeddings' };\nconst MAX_BYTES = 6 * 1024 * 1024;   // page images for the vision fallback are sent as base64\nconst b = $json.body || {};\nconst op = String(b.op || '');\nif (!ALLOWED[op]) return [{ json: { ok: false, status: 400, error: 'unknown op' } }];\nif (!b.payload || typeof b.payload !== 'object') return [{ json: { ok: false, status: 400, error: 'payload missing' } }];\nconst size = JSON.stringify(b.payload).length;\nif (size > MAX_BYTES) return [{ json: { ok: false, status: 413, error: 'payload too large' } }];\nconst payload = { ...b.payload };\nif (op === 'responses') payload.store = false;      // never keep document text at OpenAI\nreturn [{ json: { ok: true, url: ALLOWED[op], payload } }];\n"
      }
    },
    {
      "id": "51fb4c23-6029-45c5-8c4d-ce3d3bce32ce",
      "name": "Allowed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "1234e25a-0343-4dfc-9b37-cb14f0b53682",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a2f81a38-7bbf-4b06-b30c-9575f308ee8b",
      "name": "Call OpenAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        280
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {
          "timeout": 110000
        }
      },
      "onError": "continueErrorOutput",
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_ME",
          "name": "<your openAiApi credential>"
        }
      }
    },
    {
      "id": "85eea65f-2151-4100-9129-f9c0a017977f",
      "name": "Reply: result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        920,
        180
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "521c2bd3-eea5-4f88-af90-b27e7f512b22",
      "name": "Reply: upstream error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        920,
        380
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'upstream', detail: String($json.error && ($json.error.message || $json.error)).slice(0, 400) }) }}",
        "options": {
          "responseCode": 502
        }
      }
    },
    {
      "id": "70ffbe95-2463-486e-ae9c-594adf96614f",
      "name": "Reply: rejected",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        680,
        520
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: $json.error }) }}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "id": "07abbd25-36dc-45f3-9f0a-cca4be19a041",
      "name": "Note: DocIntel AI Gateway",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -40
      ],
      "parameters": {
        "content": "## DocIntel AI Gateway\nKeeps the OpenAI key inside n8n. The DocIntel worker sends `{op, payload}` with the `X-DocIntel-Key` header.\n\n**Allowed ops:** `responses` (extraction, vision fallback), `embeddings` (semantic search).\n**Privacy:** `store:false` is forced; successful and failed executions are not saved, so no document text stays in n8n.",
        "width": 620,
        "height": 260
      }
    },
    {
      "id": "0b016f18-a8d9-43dc-8ee4-40db43f93fd4",
      "name": "Notice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        580
      ],
      "parameters": {
        "jsCode": "\n// OpenAI returned an error: tell the team. Only the error line is sent on, never document text.\nconst j = $input.first().json;\nreturn [{ json: { source: 'DocIntel \u00b7 AI gateway', title: 'AI request failed',\n                  detail: String((j.error && (j.error.message || j.error)) || 'Unknown error').slice(0, 200) } }];\n"
      }
    },
    {
      "id": "73d759d8-b238-4fa5-ae41-28decbaafe2b",
      "name": "Tell the team",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1160,
        580
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "REPLACE_WITH_ALERTS_WORKFLOW_ID",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": false
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Check request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check request": {
      "main": [
        [
          {
            "node": "Allowed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Allowed?": {
      "main": [
        [
          {
            "node": "Call OpenAI",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reply: rejected",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call OpenAI": {
      "main": [
        [
          {
            "node": "Reply: result",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reply: upstream error",
            "type": "main",
            "index": 0
          },
          {
            "node": "Notice",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notice": {
      "main": [
        [
          {
            "node": "Tell the team",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false,
    "executionTimeout": 150
  }
}
