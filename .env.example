# Copy to .env and fill in. Never commit .env.

# --- AI ---------------------------------------------------------------
# "openai": call OpenAI directly with your key (simplest for local runs)
# "n8n":    call an n8n webhook that holds the key (see n8n/README.md)
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
EXTRACTION_MODEL=gpt-4.1-mini
VISION_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
AI_CONCURRENCY=4
AI_DAILY_CALL_LIMIT=3000

# --- Access -------------------------------------------------------------
# Comma-separated access codes. Empty = open: nobody is asked for a code (local runs, public demo).
# Set one or more codes to lock the app: every request then needs a valid code.
ACCESS_CODES=
CORS_ORIGINS=http://localhost:3000

# --- Limits -------------------------------------------------------------
MAX_FILE_MB=50
MAX_FILES_PER_UPLOAD=50
MAX_PAGES=1500
UPLOADS_PER_MINUTE=60
OCR_DPI=300

POSTGRES_PASSWORD=docintel

# --- Server deployment only (deploy/docker-compose.server.yml) -----------
# Public host name of the API, for the HTTPS router
# API_HOST=
